DISCORD_TOKEN=<YOUR_DISCORD_TOKEN>
PREFIX=<YOUR_PREFIX>

# Optional: scope slash-command registration to a single guild for instant
# updates. When unset, commands register globally (Discord propagation
# can take up to an hour).
# GUILD_ID=<YOUR_GUILD_ID>
# Optional: show the underlying error (e.g. yt-dlp's message) in error replies,
# not just the generic one. Useful while setting up; may expose internals.
# DETAILED_ERRORS=true
