DISCORD_TOKEN=<YOUR_DISCORD_TOKEN>
PREFIX=<YOUR_PREFIX>

# Optional: scope slash-command registration to a single guild for instant
# updates. When unset, commands register globally (Discord propagation
# can take up to an hour).
# GUILD_ID=<YOUR_GUILD_ID>
# Optional: show the underlying error (e.g. yt-dlp's message) in error replies,
# not just the generic one. Useful while setting up; may expose internals.
# DETAILED_ERRORS=true

# Optional: an HTTP proxy for music (yt-dlp and the audio stream), for when
# YouTube blocks this server's IP ("Sign in to confirm you're not a bot").
# MEDIA_PROXY=http://10.0.0.2:8888

# Optional: size of the on-disk cache of played tracks (data/audio-cache), so
# replays and loops start at once without YouTube traffic, and the next track is
# downloaded ahead. 0 turns it off.
# AUDIO_CACHE_SIZE=1G
# Optional: leave the voice channel after this long with an empty queue or nobody
# listening (e.g. 10m, 1h). Unset or off: stay until `leave`.
# AUTO_LEAVE=10m
# Optional: wait until YouTube serves a new stream before fetching it. Off by
# default; a refused stream is waited for and retried once either way.
# WAIT_FOR_STREAM=true
